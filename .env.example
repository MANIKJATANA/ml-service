# ---------------------------------------------------------------------------
# Sample environment file. Copy to `.env` and fill in real values:
#     cp .env.example .env        # (PowerShell:  Copy-Item .env.example .env)
#
# `.env` is gitignored — never commit real secrets. docker compose auto-loads
# `.env` from the repo root for ${VAR} substitution.
#
# LEGEND:  [now] used by the current stack   [P3]/[P4]/[P5] used from Phase 3/4/5.
# Everything except the Supabase keys has a dev default baked into
# docker-compose.yml, so `scripts/up.ps1` works with NO .env at all today.
# ---------------------------------------------------------------------------

# --- ML metadata database ---------------------------------------------- [now]
# The `migrate` step and (from P3) the app read this. Dev default points at the
# bundled compose Postgres; override only for an external DB.
ML_DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/app

# --- Redis (job queue) -------------------------------------------------- [P3]
ML_REDIS_URL=redis://redis:6379/0
# Socket read timeout (s). MUST exceed the worker's 5s XREADGROUP BLOCK window,
# else redis-py 8.x's 5s default trips a TimeoutError on every idle poll (0018).
ML_REDIS_SOCKET_TIMEOUT_S=30
# Consumer group / stream names. ML_QUEUE_CONSUMER defaults to a unique
# per-process id (worker-<host>-<pid>); set it explicitly only to pin an identity.
ML_QUEUE_STREAM=inference-jobs
ML_QUEUE_GROUP=inference-workers
# ML_QUEUE_CONSUMER=worker-1
# ML_QUEUE_DEAD_LETTER_STREAM=        # empty -> "{stream}:dead"

# --- Supabase Storage (MediaStore + FAISS index store) ------------------ [P3]
# SECRET: ML_SUPABASE_KEY is a real secret. Keep it only in .env, never in code.
ML_SUPABASE_URL=https://your-project-ref.supabase.co
ML_SUPABASE_KEY=your-supabase-service-role-or-access-key
ML_SUPABASE_BUCKET=media
# Optional: separate bucket for FAISS index blobs (empty -> reuse ML_SUPABASE_BUCKET).
# ML_SUPABASE_INDEX_BUCKET=faiss-indexes

# --- FAISS index store + local paths ------------------------------------ [P3]
# index_store_impl=local_fs writes index files under this dir (shared volume in
# compose); =supabase uses the bucket above. media_dir backs media_store=local_fs.
ML_INDEX_STORE_DIR=/var/lib/ml-service/faiss
ML_FAISS_CACHE_SIZE=32
ML_MEDIA_DIR=/var/lib/ml-service/media

# --- Face models (InsightFace buffalo_l) -------------------------------- [now]
# Baked into the Docker image at build time (see services/ml_service/Dockerfile);
# this points the adapters at the model dir. Override only for a custom mount.
ML_MODEL_DIR=/models/buffalo_l

# --- Test UI (dev only) ------------------------------------------------- [now]
# Serves a browser page at GET /test to hand-test enroll + identify. Compose
# defaults this to true for local; keep it false/unset in production.
ML_ENABLE_TEST_UI=true

# --- Observability (requirements §13) ----------------------------------- [now]
# JSON logs by default; set false for human-readable console logs in local dev.
ML_LOG_JSON=true
# OTLP/HTTP trace endpoint. Empty -> tracing stays a no-op (no exporter).
# e.g. http://otel-collector:4318/v1/traces
ML_OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Decision tunables (requirements §12) ------------------------------- [P3]
ML_DEFAULT_MATCH_CONFIDENCE_THRESHOLD=0.65
ML_DEFAULT_GAP_THRESHOLD=0.08
ML_VIDEO_SAMPLE_FPS=1.0
ML_TOP_K=2

# --- Adapter selection (requirements §12) ------------------------------- [P3]
# Defaults are the real adapters; swapping is a config-only change (NFR-1/2).
# For OFFLINE Windows/CI dev, override to the local/dev adapters (all real, not
# mocks): ML_MEDIA_STORE_IMPL=local_fs  ML_VIDEO_EXTRACTOR_IMPL=opencv
# ML_QUEUE_IMPL=inproc  (detector/embedder still need the models + Linux wheels).
ML_MEDIA_STORE_IMPL=supabase
ML_INDEX_STORE_IMPL=local_fs
ML_VECTOR_INDEX_IMPL=faiss
ML_DETECTOR_IMPL=scrfd
ML_EMBEDDER_IMPL=arcface
ML_VIDEO_EXTRACTOR_IMPL=decord
ML_MATCH_REPO_IMPL=postgres
ML_THRESHOLD_PROVIDER_IMPL=postgres
ML_REFERENCE_PHOTO_REPO_IMPL=postgres
ML_QUEUE_IMPL=redis

# --- Event-level inference (Phase 5, decisions/0027) ------------------- [P5]
# The queue now carries ONE job per EVENT ({school_id, event_id}); the worker reads the
# backend's `media` roster AND writes the backend's event/media status columns via the
# shared DB (same ML_DATABASE_URL) — that's how job status flows (no backend poller).
# This selector picks that read+write adapter.
ML_BACKEND_EVENT_STORE_IMPL=postgres

# --- Test-only (optional) ---------------------------------------------- [test]
# Point the gated integration tests at real services (else those tests skip).
# When the compose stack is up, Postgres/Redis are on localhost:5432 / :6379.
ML_TEST_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
ML_TEST_REDIS_URL=redis://localhost:6379/0
# ML_TEST_FACE_IMAGE=/absolute/path/to/a/face.jpg
# ML_MODEL_DIR must also be set (above) to run the InsightFace adapter test.

# --- ML: code-supported, previously undocumented (defaults) ------------- [now]
# Backend infers job-completion from a media_detections row, so this MUST stay
# true for the backend distribution pipeline to work (decisions/0022).
ML_PERSIST_DETECTIONS=true
ML_DETECTION_REPO_IMPL=postgres
ML_SERVICE_NAME=ml-service
ML_LOG_LEVEL=INFO
ML_DB_ECHO=false
ML_READINESS_TIMEOUT_S=5.0

# =======================================================================
# Backend (BE_*) --------------------------------------------------- [P1-P3]
# Backend & ML share ONE Postgres — keep BE_DATABASE_URL in sync with
# ML_DATABASE_URL above. Values below are the code defaults.
# =======================================================================
BE_DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/app
BE_DB_ECHO=false
BE_ML_SERVICE_URL=http://ml-service:8000
# SECRET + REQUIRED: HS256 signing key. No default -> the app fails loud if empty.
# Use a random >=32-byte value per environment, e.g. `openssl rand -hex 32`.
BE_JWT_SECRET=change-me-to-a-random-32-byte-secret
BE_JWT_ALGORITHM=HS256
BE_JWT_ISSUER=backend
BE_ACCESS_TOKEN_TTL_S=900
BE_REFRESH_TOKEN_TTL_S=1209600
BE_SERVICE_NAME=backend
BE_LOG_LEVEL=INFO
BE_LOG_JSON=true
BE_READINESS_TIMEOUT_S=5.0
# CORS allow-list for browser callers (the FE), comma-separated. Must be explicit
# origins ("*" is rejected at startup — a credentialed wildcard would reflect any
# origin). The default below is the local FE dev origin (Next.js on :3000 calling the
# backend on :8001), so the FE works out of the box after `cp .env.example .env`. Add
# your deployed origin(s) for prod, e.g. https://app.example.com. Empty -> no CORS.
BE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Adapter selectors (name -> class via the wiring registry).
BE_REPOSITORY_IMPL=postgres
BE_PASSWORD_HASHER_IMPL=argon2
BE_TOKEN_SERVICE_IMPL=jwt
BE_PERMISSION_RESOLVER_IMPL=static

# --- Students + ML enrollment (Phase 4, decisions/0026) --------------- [P4]
# ML enrollment API (HTTP). Timeout is generous: enroll fetches+detects+embeds, and
# the ML service loads buffalo_l lazily on its first request (slow cold start on CPU).
BE_ML_HTTP_TIMEOUT_S=60.0
# Adapter selectors. For OFFLINE dev (no Supabase / no ML), set:
#   BE_OBJECT_STORE_IMPL=local_fs  BE_ML_ENROLLMENT_CLIENT_IMPL=fake
BE_OBJECT_STORE_IMPL=supabase
BE_ML_ENROLLMENT_CLIENT_IMPL=http
# Supabase Storage — the backend mints signed reference-photo upload URLs here; the
# FE uploads directly and the ML service fetches from the SAME bucket. Point these at
# the same project as ML_SUPABASE_* above; BE_SUPABASE_BUCKET MUST equal
# ML_SUPABASE_BUCKET. SECRET: BE_SUPABASE_KEY is a real secret — keep it only in .env.
BE_SUPABASE_URL=https://your-project-ref.supabase.co
BE_SUPABASE_KEY=your-supabase-service-role-or-access-key
BE_SUPABASE_BUCKET=media
# Object-key prefix for reference photos (distinct from events/…, decisions/0022).
BE_REFERENCE_PHOTO_PREFIX=reference-photos
# Advertised per-photo upload cap; enforced client-side in v1 (server-side is a follow-up).
BE_MAX_UPLOAD_MB=30
# local_fs object-store dev target (used only when BE_OBJECT_STORE_IMPL=local_fs).
BE_OBJECT_STORE_DIR=/var/lib/backend/objects

# --- Events + media + event-level processing + status (Phase 5, 0027) - [P5]
# Event-job producer. For OFFLINE dev (no Redis), set BE_EVENT_JOB_PRODUCER_IMPL=inproc.
BE_EVENT_JOB_PRODUCER_IMPL=redis
# The shared Redis the ML worker consumes from (same instance as ML_REDIS_URL).
BE_REDIS_URL=redis://redis:6379/0
# The enqueue stream. MUST equal ML_QUEUE_STREAM — the worker reads event jobs here.
BE_QUEUE_STREAM=inference-jobs
# Object-key prefix for event media (distinct from reference-photos/…, decisions/0022).
BE_EVENT_MEDIA_PREFIX=events
# (No poller: the ML worker writes the event/media status columns directly; the backend
# reads them in one DB call. See decisions/0027.)

# --- Galleries + download (Phase 6, 0028) --------------------------- [P6]
# TTL (seconds) of the short-lived signed download URLs the galleries mint on demand.
BE_DOWNLOAD_URL_TTL_S=3600

# --- Notifications / distribution (BP4, decisions/0041) -------------
# Outbound channels the "Notify students" action fans out to, comma-separated (like
# BE_CORS_ORIGINS). Default "log" (structured, PII-free). Empty -> outbound disabled
# (the in-app new-photos signal is unaffected). email/whatsapp are future channels.
BE_NOTIFICATION_CHANNELS=log

# --- Rate limiting (BP8c, decisions/0051) ---------------------------
# A fixed-window request throttle: a global bucket + a per-school bucket (school_id from
# the JWT) + a stricter bucket on /v1/auth/*. memory = per-replica; redis = cross-replica
# (reuses BE_REDIS_URL). Fail-open on a store outage. Set BE_RATE_LIMIT_ENABLED=false to
# disable. There is no per-IP tier (the backend sits behind the Next BFF, so it can't see
# the client IP — per-IP limiting belongs at the edge/ingress).
BE_RATE_LIMIT_ENABLED=true
BE_RATE_LIMIT_IMPL=memory  # memory (per-replica) | redis (cross-replica)
BE_RATE_LIMIT_WINDOW_S=60
BE_RATE_LIMIT_GLOBAL_PER_MIN=6000
BE_RATE_LIMIT_SCHOOL_PER_MIN=600
# A single bucket shared across all schools' /v1/auth/* (no per-IP behind the BFF) — a
# coarse brute-force ceiling; keep it generous so real concurrent logins aren't locked out.
BE_RATE_LIMIT_AUTH_PER_MIN=300

# --- Security headers (BP8c, decisions/0051) ------------------------
# Defense-in-depth headers on every API response (the browser-facing set incl. the CSP is
# in the FE next.config). Enable HSTS only behind TLS in prod (dev is http).
BE_SECURITY_HEADERS_ENABLED=true
BE_HSTS_ENABLED=false
BE_HSTS_MAX_AGE_S=63072000

# Test-only: point the gated backend repo tests at a host DB (else they skip).
BE_TEST_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
# Test-only: point the gated Redis rate-limiter test at a host Redis (else it skips).
BE_TEST_REDIS_URL=redis://localhost:6379/0

# =======================================================================
# Frontend (Next.js BFF) ----------------------------------------------- [FE]
# The browser talks ONLY to the Next app; Next server-side route handlers proxy
# to the backend (decisions/0030). SERVER-ONLY — never expose as NEXT_PUBLIC_*.
# Local dev: Next reads frontend/.env.local. Compose: the frontend service gets
# this env. Requires Node >= 20.9 (Next 16); a frontend/.nvmrc pins Node 22.
# =======================================================================
# Origin of the FastAPI backend as seen from the Next server. Inside compose =
# http://backend:8000. For host dev use the IPv4 literal 127.0.0.1 (NOT "localhost"):
# Node's fetch resolves localhost to IPv6 ::1 first, which Docker Desktop's published
# port may refuse (ECONNREFUSED) even though curl works.
BFF_BACKEND_ORIGIN=http://127.0.0.1:8001
